# --- Claude (minutes generation) --------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
MMA_MODEL=claude-opus-5

# --- Agent behaviour ---------------------------------------------------------
MMA_DATA_DIR=data
MMA_OUTPUT_DIR=out
MMA_CHUNK_CHARS=40000
MMA_TRANSCRIPT_GRACE_SECONDS=120
MMA_POST_MINUTES_TO_CHAT=false
MMA_OPT_OUT_MARKERS=/nominutes,#offrecord
MMA_IGNORE_MARKERS=#private

# --- Microsoft Teams (Microsoft Graph, app-only) -----------------------------
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_ORGANIZER_USER_ID=
TEAMS_NOTIFICATION_URL=https://your-host/webhooks/teams
TEAMS_SUBSCRIPTION_CLIENT_STATE=some-long-random-string

# --- Zoom (server-to-server OAuth app) ---------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
